# 复制本文件为 .env 并填入真实值
# 本项目的 LLM 调用全部走 OpenAI 兼容接口，因此只需改 base_url/model 即可切换供应商。

# ============================================================
# 1. LLM 聊天模型配置（Agent 写 gen.cpp / validator.cpp / range.json）
# ============================================================

# OpenAI 官方：
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=                  # 留空用默认 https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# DeepSeek（OpenAI 兼容）：
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# 智谱（OpenAI 兼容）：
#   LLM_API_KEY=...
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash
#
# 通义/阿里云（OpenAI 兼容）：
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-turbo

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# 单次补全最大输出 token（含 write_gen 的 tool arguments）。默认 16384，减轻源码 JSON 截断。
# 设为 -1 表示不传该参数（用服务商默认）。
LLM_MAX_TOKENS=16384

# ============================================================
# 2. Embedding 模型配置（RAG few-shot 召回用）
# ============================================================
# 必须设置 EMBEDDING_API_KEY 才会启用 RAG 语义召回。
# 未设置时自动降级：按题型/关键词选用固定模板，不调用 embedding 接口。
# （chat 用 DeepSeek、embedding 用通义时，请填写下面 EMBEDDING_*）
#
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# OpenAI 官方：
#   LLM_BASE_URL=                 # 默认 https://api.openai.com/v1
#   LLM_EMBEDDING_MODEL=text-embedding-3-small
#                  或 text-embedding-3-large
#
# DeepSeek：  目前不单独提供 embedding 接口，建议 embedding 改接 OpenAI / 智谱 / 通义
#
# 智谱（OpenAI 兼容）：
#   EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_EMBEDDING_MODEL=embedding-3
#
# 通义/阿里云（OpenAI 兼容，推荐国内使用）：
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_EMBEDDING_MODEL=text-embedding-v3
#                  或 text-embedding-v2
#                  或 text-embedding-v1

LLM_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# 3. RAG 召回参数（可选）
# ============================================================
# RAG_TOP_K=2                    # 每次召回多少个相似范例
# RAG_DEDUP_THRESHOLD=0.95       # 历史任务入库时，相似度超过多少视为重复
# RAG_QUALITY_MIN_TIME_S=1       # 历史任务最低生成耗时（秒）
# RAG_QUALITY_MAX_TIME_S=300     # 历史任务最高生成耗时（秒）
# RAG_QUALITY_MIN_VALID_RATE=0.999  # 历史任务有效生成比例

# ============================================================
# 4. 后端服务器运行参数（可选）
# ============================================================
# GUI 启动服务器 和 直接运行 server/app.py 时都会读取这些变量。
# 若留空或设置无效，则使用默认值 host=127.0.0.1, port=8000。

SERVER_HOST=127.0.0.1
SERVER_PORT=8000
